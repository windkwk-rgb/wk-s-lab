<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PenBridge</AssemblyName>
    <RootNamespace>PenBridge</RootNamespace>
    <!-- 버전은 저장소 루트의 version.txt 하나로 관리 (태블릿 앱과 공유) -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\version.txt').Trim())</Version>
    <Product>PenBridge</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- 고해상도 화면에서 좌표가 어긋나지 않도록 실제 픽셀 좌표를 사용 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 설치 없이 실행되는 단일 exe로 배포 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Linux/macOS(예: GitHub Actions)에서도 빌드 가능하게 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- 화면(UI)은 HTML로 만들고 Windows 내장 WebView2로 표시 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <EmbeddedResource Include="ui\index.html" LogicalName="ui.index.html" />
    <EmbeddedResource Include="ui\qrcode.js" LogicalName="ui.qrcode.js" />
    <EmbeddedResource Include="tray\tray-idle-dark.ico" LogicalName="tray.idle-dark.ico" />
    <EmbeddedResource Include="tray\tray-idle-light.ico" LogicalName="tray.idle-light.ico" />
    <EmbeddedResource Include="tray\tray-on.ico" LogicalName="tray.on.ico" />
  </ItemGroup>

  <!-- 태블릿 앱을 exe 안에 넣어 둠 → exe만 업데이트해도 태블릿 앱까지 함께 업데이트 -->
  <ItemGroup Condition="Exists('tablet\PenBridge.apk')">
    <EmbeddedResource Include="tablet\PenBridge.apk" LogicalName="PenBridge.apk" />
  </ItemGroup>

</Project>
